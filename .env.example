# Copie para .env e preencha. Nunca faça commit do arquivo .env.
# Opcional: sem estas variáveis o ETL ainda gera arquivos locais (JSON/CSV/etc.).

SUPABASE_URL=https://seu-projeto.supabase.co

# Preferencial com RLS ativo (uso apenas em servidor / scripts locais — nunca no frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Schema PostgreSQL onde o ETL grava as tabelas SINAPI (sinapi_referencias, insumos, …).
# Se omitir, usa "public". Altere só se as tabelas estiverem noutro schema (ex.: datasin_v2).
SUPABASE_SCHEMA=public

# Legado / alternativa se SERVICE_ROLE não estiver definida (pode falhar com RLS restritivo)
# SUPABASE_KEY=
